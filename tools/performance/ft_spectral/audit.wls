input=Import[Environment["DIFFEXP_FT_AUDIT_INPUT"],"RawJSON"];
val[e_]:=If[e===0,Infinity,With[{t=Together[e]},Exponent[Numerator[t],eps,Min]-Exponent[Denominator[t],eps,Min]]];
shifts[v_,target_]:=Module[{n=Length[v],s=ConstantArray[0,Length[v]],changed=False},Do[changed=False;Do[If[v[[i,j]]=!=Infinity&&s[[i]]>s[[j]]+v[[i,j]]-target,s[[i]]=s[[j]]+v[[i,j]]-target;changed=True],{i,n},{j,n}];If[!changed,Return[s-Min[s]]],{n}];If[changed,"impossible",s-Min[s]]];
diag[a_]:=Module[{f,c,sol,eq,res},If[a===0,Return[<|"a0"->"0","factors"->{}|>]];f=First/@Rest[FactorList[Denominator[Together[a]]]];c=Array[z,Length[f]];eq=Numerator[Together[a-Sum[c[[i]] D[f[[i]],x]/f[[i]],{i,Length[f]}]]];sol=Solve[Thread[CoefficientList[eq,x]==0],c];If[Length[sol]==0,Return[<|"a0"->ToString[a,InputForm],"log_derivative"->False|>]];res=c/.First[sol];<|"a0"->ToString[a,InputForm],"factors"->MapThread[{ToString[#1,InputForm],ToString[#2,InputForm]}&,{f,res}],"rational_gauge"->And@@(IntegerQ/@res)|>];
results=Table[Module[{m=Map[ToExpression,item["matrix"],{2}],v,s,g,a,n,edges,components,p},n=Length[m];v=Map[val,m,{2}];s=shifts[v,0];g=Table[Cancel[m[[i,j]]eps^(s[[j]]-s[[i]])],{i,n},{j,n}];a=Map[Cancel[#/.eps->0]&,g,{2}];edges=Flatten[Table[If[i!=j&&a[[i,j]]=!=0,DirectedEdge[j,i],Nothing],{i,n},{j,n}]];components=ConnectedComponents[Graph[Range[n],edges]];p=shifts[Map[val,g,{2}],1];Print[item["family"]," d=",n," scc=",Length/@components];<|"family"->item["family"],"path"->item["path"],"physical_count"->item["physical_count"],"dimension"->n,"basis"->item["basis"],"epsilon_shifts"->s,"positive_shear"->p,"positive_shear_after_diagonal_removal"->shifts[Map[val,g-DiagonalMatrix[Diagonal[a]],{2}],1],"zero_scc"->components,"zero_edges"->(List@@@edges),"diagonals"->(diag/@Diagonal[a])|>],{item,input}];
Export[Environment["DIFFEXP_FT_AUDIT_OUTPUT"],results,"RawJSON"];
